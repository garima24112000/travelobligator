# TravelObligator -- environment template (Step 181D)
#
# Copy this file to `.env` (`cp .env.example .env`) and edit only what you
# need. Every value below is either the same default `backend/app/core/
# config.py` already uses, or an empty placeholder for an optional secret.
# Nothing here needs to change to run the app locally with its honest
# default behavior: most providers default to `not_connected`, and the
# two `scraped_local` providers (accommodation/flights) read a local file
# that does not exist yet, so they honestly report `unavailable`.
#
# Never commit a real `.env` file with real secrets. This template file
# itself contains no real API keys.

# --- App basics ---
APP_NAME=TravelObligator
APP_ENV=development
APP_DEBUG=true
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Persistence (interim, pre-database -- see ARCHITECTURE.md section 12a) ---
# Trips/planning states are actually persisted to this local, gitignored
# JSON file today, not to a database.
LOCAL_STORAGE_PATH=.data/travelobligator_state.json

# DATABASE_URL / REDIS_URL are declared in config.py and read by
# docker-compose.yml's postgres/redis containers, but no code path in
# backend/app/ actually reads a database or a cache today. Setting these
# has no effect on current app behavior.
DATABASE_URL=postgresql://travelobligator_user:change_me@postgres:5432/travelobligator
REDIS_URL=redis://redis:6379/0

# --- Provider cache (local SQLite cache for real provider responses) ---
PROVIDER_CACHE_ENABLED=true
PROVIDER_CACHE_PATH=.data/provider_cache.sqlite3
OPEN_METEO_CACHE_TTL_SECONDS=3600
NAGER_DATE_CACHE_TTL_SECONDS=2592000
FRANKFURTER_CACHE_TTL_SECONDS=21600
OSM_GEOCODE_CACHE_TTL_SECONDS=2592000
OSM_POI_CACHE_TTL_SECONDS=604800

# --- Real, connected-by-default provider endpoints ---
# These are already live/connected with no extra configuration -- you
# generally never need to change them.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
NOMINATIM_API_URL=https://nominatim.openstreetmap.org
OPEN_METEO_API_URL=https://api.open-meteo.com
NAGER_DATE_API_URL=https://date.nager.at
FRANKFURTER_API_URL=https://api.frankfurter.app

# --- Safety flags ---
# ALLOW_MOCK_TRAVEL_FACTS must stay false -- this app never fabricates
# travel facts as a matter of policy, not just a default.
USE_REAL_PROVIDERS=true
ALLOW_MOCK_TRAVEL_FACTS=false

# --- Routing provider (optional) ---
# "not_connected" (default) or "osrm". Setting ROUTING_PROVIDER=osrm alone
# still does nothing live unless OSRM_BASE_URL is also set -- no route
# time or path is ever shown when not connected.
ROUTING_PROVIDER=not_connected
# OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_SECONDS=15.0
OSRM_PROFILE=driving
OSRM_ROUTE_CACHE_TTL_SECONDS=86400

# --- Route-aware scheduling ---
# Uses provider-backed movement data when available; a documented
# deterministic fallback order otherwise. Only ever applies a suggestion
# with a genuinely positive real improvement.
ROUTE_AWARE_SCHEDULING_ENABLED=true
ROUTE_AWARE_SCHEDULING_MIN_IMPROVEMENT_SECONDS=0.0

# --- Accommodation inventory ---
# "not_connected" or "scraped_local" (default). scraped_local reads a
# local, developer-supplied static HTML file only -- it never fetches a
# live website. With no file at the path below, it honestly reports
# `unavailable`, never fabricated data.
ACCOMMODATION_PROVIDER=scraped_local
SCRAPING_ENABLED=true
SCRAPED_ACCOMMODATION_PROVIDER_ENABLED=true
SCRAPED_ACCOMMODATION_HTML_PATH=.data/manual_scrapes/accommodations.html
SCRAPED_ACCOMMODATION_SOURCE_ID=manual_local_scraped_accommodation
SCRAPED_ACCOMMODATION_SOURCE_NAME=Manual local scraped accommodation source
# SCRAPED_ACCOMMODATION_BASE_URL=
SCRAPED_ACCOMMODATION_CACHE_ENABLED=true
SCRAPED_ACCOMMODATION_CACHE_TTL_SECONDS=3600
SCRAPING_DEFAULT_RATE_LIMIT_SECONDS=10

# --- Hotel ratings (optional; no live rating provider exists yet) ---
# "not_connected" is the only supported value today. This layer can
# enrich a lodging offer with a provider-backed rating snapshot once a
# real ratings provider is wired in -- never a quality guarantee.
HOTEL_RATINGS_PROVIDER=not_connected

# --- Flight inventory ---
# "not_connected", "scraped_local" (default), or "kiwi_mcp" (see below).
# scraped_local mirrors the accommodation parser: local file only, never
# live scraping, honestly `unavailable` with no file present.
FLIGHT_PROVIDER=scraped_local
SCRAPED_FLIGHT_PROVIDER_ENABLED=true
SCRAPED_FLIGHT_HTML_PATH=.data/manual_scrapes/flights.html
SCRAPED_FLIGHT_SOURCE_ID=manual_local_scraped_flight
SCRAPED_FLIGHT_SOURCE_NAME=Manual local scraped flight source
# SCRAPED_FLIGHT_BASE_URL=
SCRAPED_FLIGHT_CACHE_ENABLED=true
SCRAPED_FLIGHT_CACHE_TTL_SECONDS=3600

# --- Kiwi MCP flight provider (optional; real, live, third-party) ---
# Off by default. Requires BOTH FLIGHT_PROVIDER=kiwi_mcp above AND
# KIWI_MCP_ENABLED=true here -- either alone does nothing live. When
# enabled, this makes a real network call to Kiwi's hosted MCP server.
# Any booking link returned is a provider-supplied third-party link, not
# a booking confirmation.
KIWI_MCP_ENABLED=false
KIWI_MCP_ENDPOINT=https://mcp.kiwi.com
KIWI_MCP_TIMEOUT_SECONDS=10.0
# KIWI_MCP_TOOL_NAME=

# --- AI candidate proposal (optional; reasoning/proposal only) ---
# "not_connected" (default), "anthropic", or "groq". Neither is ever a
# source of factual travel data -- a suggestion only reaches the
# itinerary after independent provider-grounding and explicit promotion.
# AI_CANDIDATE_DISCOVERY_SHADOW_MODE_ENABLED must also be true for either
# to actually run during plan generation.
AI_CANDIDATE_PROPOSAL_PROVIDER=not_connected
AI_CANDIDATE_DISCOVERY_SHADOW_MODE_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# OPENAI_API_KEY/OPENAI_MODEL are declared in config.py but are not
# referenced anywhere else in the codebase today -- Anthropic/Groq are
# the actual wired AI-candidate-proposal bases. Left here only because
# the field still exists in config.py; setting it has no effect.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Other declared-but-not-yet-connected provider keys (optional) ---
# None of these are wired into any provider adapter yet -- setting them
# has no effect on current app behavior.
GOOGLE_PLACES_API_KEY=
GOOGLE_ROUTES_API_KEY=
MAPBOX_ACCESS_TOKEN=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# --- Planning engine selection ---
# "langgraph" (default) or "legacy". Both call the exact same
# deterministic stage services in the same order -- this only changes how
# the stages are invoked, never what any stage may decide or invent.
PLANNING_ENGINE_MODE=langgraph
