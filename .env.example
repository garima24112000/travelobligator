# TravelObligator -- environment template (Step 181D)
#
# Copy this file to `.env` (`cp .env.example .env`) and edit only what you
# need. Every value below is either the same default `backend/app/core/
# config.py` already uses, or an empty placeholder for an optional secret.
# Nothing here needs to change to run the app locally with its honest
# default behavior: most providers default to `not_connected`, and the
# two `scraped_local` providers (accommodation/flights) read a local file
# that does not exist yet, so they honestly report `unavailable`.
#
# Never commit a real `.env` file with real secrets. This template file
# itself contains no real API keys.

# --- App basics ---
APP_NAME=TravelObligator
APP_ENV=development
APP_DEBUG=true
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# NEXT_PUBLIC_API_BASE_URL (Step 188B, docs/16_frontend_architecture.md
# section 55) -- read by `frontend/lib/api.ts` as the base URL for every
# API call. This is a FRONTEND/browser value, not a backend setting: it
# is baked into the frontend build/dev process and sent to the browser
# in plain text, so it must never hold a secret (see the safety note
# below) -- it is not read from this root `.env` file by the backend at
# all; a real frontend deployment sets it as its own environment
# variable, wherever that frontend is built/hosted, not here. It is
# listed in this template only so the full config surface is documented
# in one place.
#
# Local dev / local `docker compose up` (the default, safe out of the
# box): leave this at `http://localhost:8000`, or unset entirely --
# `frontend/lib/api.ts` already falls back to that same value when this
# is unset. This works for `docker compose` too, not just bare `npm run
# dev`: the request is made by the BROWSER on your own machine (not by
# the frontend container internally), and `docker-compose.yml` publishes
# the backend container's port 8000 to `localhost:8000` on your host --
# so the browser reaching `http://localhost:8000` really does hit the
# backend container either way.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
#
# Deployed (non-local) frontend: set this to the backend's real,
# browser-routable HTTPS origin (e.g. `https://api.example.com`) --
# wherever a browser loading the deployed frontend can actually reach
# the deployed backend from. A container-internal hostname (like
# `backend` or `http://backend:8000` from `docker-compose.yml`'s own
# internal network) never works here -- the browser, not another
# container, is what sends this request. You must also add that
# deployed frontend's own real origin to `BACKEND_CORS_ORIGINS` above on
# the backend side (comma-separated if more than one), or the backend
# will correctly refuse the browser's cross-origin request. Section 188
# does not add or verify any real deployment target -- this comment only
# documents the config surface for whenever one exists.
#
# Never put a secret, API key, session key, or credential in this or any
# other `NEXT_PUBLIC_*` variable -- anything prefixed `NEXT_PUBLIC_` is
# compiled into client-side JavaScript and is visible to anyone using
# the site, exactly like a value printed in the page's own source.

# --- Persistence (interim, pre-database -- see ARCHITECTURE.md section 12a) ---
# Trips/planning states are actually persisted to this local, gitignored
# JSON file today, not to a database.
LOCAL_STORAGE_PATH=.data/travelobligator_state.json

# PERSISTENCE_BACKEND (Step 183B) gates which persistence backend the app
# uses. "local_json" (the default -- always the safe choice, keep this
# unless you deliberately want Postgres) reads/writes LocalJsonStore, the
# same behavior this app has always had. "postgres" (Step 183D+, extended
# to users in 184C and generation jobs in 186F) switches every repository
# (trips, planning states, users, generation jobs) to a real Postgres-
# backed implementation instead -- but ONLY when you explicitly set this
# to "postgres"; nothing else on this page does that for you.
#
# IMPORTANT: setting DATABASE_URL below does NOT by itself switch
# persistence to Postgres -- you must also explicitly set
# PERSISTENCE_BACKEND=postgres.
PERSISTENCE_BACKEND=local_json

# DATABASE_URL / REDIS_URL are declared in config.py and read by
# docker-compose.yml's postgres/redis containers. DATABASE_URL is only
# actually read by the app when PERSISTENCE_BACKEND=postgres (see above);
# REDIS_URL is never read by any code path in backend/app/ today.
#
# The hostname/port you use here depends on WHERE the process connecting
# is running, not on where Postgres itself runs:
#   - Backend running INSIDE `docker compose` (the `backend` service):
#     use the service name and the container's own internal port --
#     `postgres:5432` (the default below). Compose's internal network
#     resolves `postgres` regardless of what POSTGRES_HOST_PORT maps to
#     on your host.
#   - Alembic or the backend running on your HOST machine (not inside
#     compose) against a `docker compose up -d postgres` container: use
#     `localhost:<POSTGRES_HOST_PORT>` (see POSTGRES_HOST_PORT below --
#     `localhost:5432` if you left it at its default, `localhost:15432`
#     if you changed it because 5432 was already taken).
DATABASE_URL=postgresql://travelobligator_user:change_me@postgres:5432/travelobligator
REDIS_URL=redis://redis:6379/0

# Read by docker-compose.yml's postgres container only (not by the app
# itself) -- must match the credentials embedded in DATABASE_URL above if
# you change either. Only needed if you opt into `docker compose up
# postgres` for the Step 183C schema migration; not required for normal
# local_json development.
POSTGRES_DB=travelobligator
POSTGRES_USER=travelobligator_user
POSTGRES_PASSWORD=change_me

# POSTGRES_HOST_PORT (Step 183E) -- which port on YOUR machine
# docker-compose.yml's postgres container's 5432 is published to.
# Defaults to 5432 if unset (backwards compatible). A local Postgres
# install, or another project's compose stack, commonly already occupies
# 5432 -- if `docker compose up -d postgres` fails with "address already
# in use", set this to a nonstandard port instead (15432 is a common
# choice) rather than stopping whatever else is using 5432. This only
# changes the HOST side of the mapping -- containers within compose
# (e.g. `backend`) always reach Postgres at `postgres:5432` regardless of
# this value; only host-side connections (Alembic/pytest run directly on
# your machine, not inside a container) need to use this port, via
# `localhost:<this value>` in DATABASE_URL above.
# POSTGRES_HOST_PORT=15432

# --- Async job foundation (Step 186B, real orchestration in Step 186C,
# duplicate/failure/restart hardening in Step 186E, opt-in Postgres
# persistence in Step 186F --
# docs/14_backend_architecture.md sections 116-119). With
# ASYNC_GENERATION_ENABLED=false (the default), POST /trips/{trip_id}/
# generate and .../regenerate remain fully synchronous exactly as
# before this feature existed. Set it to true to make both endpoints
# return 202 + a job envelope instead, pollable via
# GET /trips/{trip_id}/jobs/{job_id}. This never means Redis/Celery/RQ/a
# worker process are in use -- REDIS_URL above stays completely unused
# by any code path in backend/app/ today; jobs are recorded via
# JobRepository, in the same local JSON file this app already uses under
# their own "jobs" collection by default, or in a real `generation_jobs`
# Postgres table when you also set PERSISTENCE_BACKEND=postgres above
# (see that setting's own comment) -- either way, jobs never resume
# across a restart; an interrupted one is honestly marked failed.
ASYNC_GENERATION_ENABLED=false

# How long (seconds) a finished job record is considered fresh enough to
# still be worth reading/showing, for a future cleanup/expiry step to
# reference. Nothing reads or enforces this yet -- JobRepository never
# deletes or hides an expired job on its own. Must be a positive number.
GENERATION_JOB_TTL_SECONDS=86400

# Maximum number of queued/running jobs allowed at once for a single
# trip -- enforced as the duplicate-job guard on both
# POST /trips/{trip_id}/generate and .../regenerate when async mode is
# on (a second request while one is already queued/running for the same
# trip gets 409 JOB_ALREADY_RUNNING). Must be at least 1.
GENERATION_JOB_MAX_RUNNING_PER_TRIP=1

# Step 186E: how long (seconds) a job may sit queued/running before it's
# treated as abandoned (a background task that died without the process
# restarting, or a process that restarted without a graceful shutdown)
# rather than genuinely still in progress -- checked before every
# duplicate-job guard and every job status read. A stale job is marked
# failed (error_code=JOB_INTERRUPTED), never deleted and never silently
# left "running" forever. Distinct from GENERATION_JOB_TTL_SECONDS above
# (that one is about a *finished* job's display lifetime, not this).
# Must be a positive number.
GENERATION_JOB_STALE_AFTER_SECONDS=3600

# Step 183C added the first Alembic schema migration (`trips` +
# `planning_states`, see docs/14_backend_architecture.md section 104).
# Step 183D added a real, working Postgres repository implementation
# behind it (see docs/14_backend_architecture.md section 105) -- but it
# all remains entirely opt-in, gated on PERSISTENCE_BACKEND=postgres
# above; the app still uses local_json by default. To try it against a
# real local Postgres: `docker compose up -d postgres` (add
# `POSTGRES_HOST_PORT=15432` before that command first if 5432 is
# already taken), then from `backend/`: `DATABASE_URL=postgresql://
# travelobligator_user:change_me@localhost:<port>/travelobligator
# alembic upgrade head`. This is never required for `pytest` or normal
# `local_json` development -- see docs/14_backend_architecture.md
# section 106 for the full opt-in verification walkthrough.

# --- Provider cache (local SQLite cache for real provider responses) ---
PROVIDER_CACHE_ENABLED=true
PROVIDER_CACHE_PATH=.data/provider_cache.sqlite3
OPEN_METEO_CACHE_TTL_SECONDS=3600
NAGER_DATE_CACHE_TTL_SECONDS=2592000
FRANKFURTER_CACHE_TTL_SECONDS=21600
OSM_GEOCODE_CACHE_TTL_SECONDS=2592000
OSM_POI_CACHE_TTL_SECONDS=604800

# --- Real, connected-by-default provider endpoints ---
# These are already live/connected with no extra configuration -- you
# generally never need to change them.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
NOMINATIM_API_URL=https://nominatim.openstreetmap.org
OPEN_METEO_API_URL=https://api.open-meteo.com
NAGER_DATE_API_URL=https://date.nager.at
FRANKFURTER_API_URL=https://api.frankfurter.app

# --- Safety flags ---
# ALLOW_MOCK_TRAVEL_FACTS must stay false -- this app never fabricates
# travel facts as a matter of policy, not just a default.
USE_REAL_PROVIDERS=true
ALLOW_MOCK_TRAVEL_FACTS=false

# --- Routing provider (optional, no-key MVP activation available) ---
# "not_connected" (default) or "osrm". Setting ROUTING_PROVIDER=osrm alone
# still does nothing live unless OSRM_BASE_URL is also set -- no route
# time or path is ever shown when not connected, and this stays the
# default unless you explicitly opt in.
#
# To enable real route feasibility/movement rows/map paths for a local
# demo with NO API key and NO signup, uncomment the OSRM_BASE_URL line
# below to point at the public OSRM demo server:
#
#   ROUTING_PROVIDER=osrm
#   OSRM_BASE_URL=https://router.project-osrm.org
#
# That demo server is free and requires no credentials, but it is a
# shared public instance with no uptime or rate-limit guarantee -- fine
# for local development/demos, not something to point production traffic
# at. If you leave OSRM_BASE_URL unset (the default), routing honestly
# stays `not_connected` even if ROUTING_PROVIDER=osrm is set.
ROUTING_PROVIDER=not_connected
# OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_SECONDS=15.0
OSRM_PROFILE=driving
OSRM_ROUTE_CACHE_TTL_SECONDS=86400

# --- Route-aware scheduling ---
# Already enabled by default. Uses provider-backed movement data when a
# routing provider is actually connected (see ROUTING_PROVIDER/
# OSRM_BASE_URL above); falls back to a documented, deterministic order
# when it isn't. Only ever applies a suggestion with a genuinely positive
# real improvement -- this flag controls whether that check is allowed to
# run at all, not whether routing itself is connected.
ROUTE_AWARE_SCHEDULING_ENABLED=true
ROUTE_AWARE_SCHEDULING_MIN_IMPROVEMENT_SECONDS=0.0

# --- Accommodation inventory ---
# "not_connected", "scraped_local", or "manual_html" (alias for
# scraped_local, Step 182E -- pick whichever name reads more clearly to
# you, both select the exact same adapter). Default is "scraped_local".
# Either name reads local, developer-supplied static HTML file(s) only --
# it never fetches a live website. With no file present, it honestly
# reports `unavailable`, never fabricated data. See README.md's
# "Provider activation" section for the full per-provider access/fallback
# matrix (Booking.com, Expedia, Hotelbeds, Hostelworld, Vrbo, Airbnb all
# require real partner/API access this app does not implement -- their
# fallback path is this same manual/local HTML approach). As of Step
# 185C, this provider is multi-source: besides the single shared file
# below, it also independently checks six per-brand files (see
# SCRAPED_ACCOMMODATION_HTML_PATH_BOOKING and friends further down) using
# their own source-specific parser modules
# (backend/app/providers/accommodation/source_parsers/) -- any
# combination of these can be present at once, and a missing one never
# blocks another source's real offers.
ACCOMMODATION_PROVIDER=scraped_local
SCRAPING_ENABLED=true
SCRAPED_ACCOMMODATION_PROVIDER_ENABLED=true
SCRAPED_ACCOMMODATION_HTML_PATH=.data/manual_scrapes/accommodations.html
SCRAPED_ACCOMMODATION_SOURCE_ID=manual_local_scraped_accommodation
SCRAPED_ACCOMMODATION_SOURCE_NAME=Manual local scraped accommodation source
# SCRAPED_ACCOMMODATION_BASE_URL=
SCRAPED_ACCOMMODATION_CACHE_ENABLED=true
SCRAPED_ACCOMMODATION_CACHE_TTL_SECONDS=3600
SCRAPING_DEFAULT_RATE_LIMIT_SECONDS=10

# Optional (Step 182E, backed by a real per-source policy registry as of
# Step 185B -- see backend/app/providers/scraping_source_registry_
# defaults.py): cosmetic provenance label for the manual/local
# accommodation file above -- "generic" (default), "booking", "expedia",
# "hotelbeds", "hostelworld", "vrbo", or "airbnb". Only changes the
# displayed source_id/source_name (e.g. "Manual/local HTML (labeled by
# user as Booking.com-derived; not official Booking.com data)") on
# parsed offers -- and only when SCRAPED_ACCOMMODATION_SOURCE_ID/_NAME
# above are left at their defaults. Never means the real Booking/Expedia/
# Hotelbeds/Hostelworld/Vrbo/Airbnb API was called, and never means that
# site was live-fetched -- every one of those six is recorded in the
# registry as not approved for live scraping (Booking/Expedia/Vrbo/
# Airbnb per this project's restricted-provider policy; Hotelbeds/
# Hostelworld pending a human robots.txt/ToS review that hasn't
# happened). An unrecognized value falls back to "generic".
ACCOMMODATION_MANUAL_HTML_SOURCE=generic

# Step 185C: independent, optional per-source local file paths --
# multi-source accommodation ingestion. Each defaults to its own real
# path under .data/manual_scrapes/ (never created automatically), so
# every source is "known and eligible" out of the box without
# fabricating anything: with no file actually present, that source is
# honestly recorded as missing (see AccommodationSearchResult.warnings)
# rather than blocking any other source that *does* have a file. These
# are independent of, and additive to, SCRAPED_ACCOMMODATION_HTML_PATH/
# ACCOMMODATION_MANUAL_HTML_SOURCE above -- supplying only the original
# single file (the pre-185C default) still works exactly as before. Set
# any of these to an empty value to disable that one source's slot
# entirely. Each source-specific parser
# (backend/app/providers/accommodation/source_parsers/) recognizes the
# same generic HTML micro-format as every other source, optionally
# annotated per-card with a synthetic data-source="<brand>" attribute --
# still never a live fetch, still never browser automation, still never
# a claim that any of these paths hold real Booking/Expedia/Hotelbeds/
# Hostelworld/Vrbo/Airbnb data.
SCRAPED_ACCOMMODATION_HTML_PATH_BOOKING=.data/manual_scrapes/accommodations_booking.html
SCRAPED_ACCOMMODATION_HTML_PATH_EXPEDIA=.data/manual_scrapes/accommodations_expedia.html
SCRAPED_ACCOMMODATION_HTML_PATH_HOTELBEDS=.data/manual_scrapes/accommodations_hotelbeds.html
SCRAPED_ACCOMMODATION_HTML_PATH_HOSTELWORLD=.data/manual_scrapes/accommodations_hostelworld.html
SCRAPED_ACCOMMODATION_HTML_PATH_VRBO=.data/manual_scrapes/accommodations_vrbo.html
SCRAPED_ACCOMMODATION_HTML_PATH_AIRBNB=.data/manual_scrapes/accommodations_airbnb.html

# --- Hotel ratings (optional; local/manual ingestion only, Step 185E) ---
# "not_connected" (default), "scraped_local", or "manual_html" (an alias
# for scraped_local, mirroring ACCOMMODATION_PROVIDER/FLIGHT_PROVIDER's
# identical alias convention). "scraped_local"/"manual_html" only ever
# read an already-supplied local HTML file (ScrapedLocalHotelRatingsProvider)
# -- never a live Tripadvisor/Google Places network call, never browser
# automation, never a quality guarantee. This layer conservatively
# enriches a lodging offer with a rating snapshot ONLY when a parsed
# rating record's property name exactly matches that offer's -- an
# ambiguous or absent match always leaves the offer's rating unmatched.
# See README.md's "Provider activation" section for Tripadvisor Content
# API access steps -- TRIPADVISOR_API_KEY below is a placeholder only; no
# Tripadvisor adapter exists, and no Tripadvisor scraping is implemented
# or planned; the manual/local path below is the only real Tripadvisor-
# labeled rating source today.
HOTEL_RATINGS_PROVIDER=not_connected

# Step 185B: independent enable flag/source-label/local-file-path config
# for the manual/local hotel-ratings adapter. "generic" (default),
# "tripadvisor", or "google_places" (resolved internally to the distinct
# "google_places_ratings" registry/parser key) for the source label --
# same cosmetic-labeling convention as
# ACCOMMODATION_MANUAL_HTML_SOURCE/FLIGHT_MANUAL_HTML_SOURCE above, never
# a claim that a real Tripadvisor/Google Places API was called. Setting
# these has no effect unless HOTEL_RATINGS_PROVIDER above is also set to
# "scraped_local"/"manual_html".
SCRAPED_HOTEL_RATINGS_PROVIDER_ENABLED=true
HOTEL_RATINGS_MANUAL_HTML_SOURCE=generic
SCRAPED_HOTEL_RATINGS_HTML_PATH=.data/manual_scrapes/hotel_ratings.html

# Step 185E: independent, optional per-source local file paths --
# multi-source hotel-ratings ingestion. Besides the single shared file
# above, both of these can be configured at once; each is parsed by its
# own source-specific parser module
# (backend/app/providers/hotel_ratings/source_parsers/). Missing files
# are recorded as warnings, never a fabricated rating; if every
# configured source is missing, the whole result stays "unavailable".
# Matching is exact (case/whitespace-insensitive) property-name matching
# only -- never fuzzy, and only a rating value + review count are ever
# extracted (no raw review text, no "top-rated"/"best" claim, no claim
# that a review has been verified).
SCRAPED_HOTEL_RATINGS_HTML_PATH_TRIPADVISOR=.data/manual_scrapes/hotel_ratings_tripadvisor.html
SCRAPED_HOTEL_RATINGS_HTML_PATH_GOOGLE_PLACES_RATINGS=.data/manual_scrapes/hotel_ratings_google_places_ratings.html

# --- Flight inventory ---
# "not_connected", "scraped_local", "manual_html" (alias for
# scraped_local, Step 182E), or "kiwi_mcp" (see below). Default is
# "scraped_local". scraped_local/manual_html mirror the accommodation
# parser: local file(s) only, never live scraping, honestly `unavailable`
# with no file present. See README.md's "Provider activation" section for
# Skyscanner's access requirements -- its fallback path is this same
# manual/local HTML approach. As of Step 185D, this provider is
# multi-source: besides the single shared file below, it also
# independently checks three per-brand files (see
# SCRAPED_FLIGHT_HTML_PATH_SKYSCANNER and friends further down) using
# their own source-specific parser modules
# (backend/app/providers/flights/source_parsers/) -- any combination of
# these can be present at once, and a missing one never blocks another
# source's real offers.
FLIGHT_PROVIDER=scraped_local
SCRAPED_FLIGHT_PROVIDER_ENABLED=true
SCRAPED_FLIGHT_HTML_PATH=.data/manual_scrapes/flights.html
SCRAPED_FLIGHT_SOURCE_ID=manual_local_scraped_flight
SCRAPED_FLIGHT_SOURCE_NAME=Manual local scraped flight source
# SCRAPED_FLIGHT_BASE_URL=
SCRAPED_FLIGHT_CACHE_ENABLED=true
SCRAPED_FLIGHT_CACHE_TTL_SECONDS=3600

# Optional (Step 182E, backed by a real per-source policy registry as of
# Step 185B -- see backend/app/providers/scraping_source_registry_
# defaults.py, registered there as "kiwi_manual" to keep it textually
# distinct from the live kiwi_mcp adapter): cosmetic provenance label for
# the manual/local flight file above -- "generic" (default), "skyscanner",
# "google_flights", "kiwi", or "other". Only changes the displayed
# source_id/source_name on parsed offers, and only when
# SCRAPED_FLIGHT_SOURCE_ID/_NAME above are left at their defaults. The
# "kiwi" value here means "this manually-saved local file is labeled by
# the user as Kiwi-derived" -- it is a completely separate, cosmetic-only
# setting from FLIGHT_PROVIDER=kiwi_mcp/KIWI_MCP_ENABLED below and never
# means live Kiwi MCP data. Google Flights and Skyscanner are both
# recorded in the registry as not approved for live scraping (Google
# Flights per this project's restricted-provider policy; Skyscanner
# pending a human robots.txt/ToS review that hasn't happened) -- this
# label never means either site was live-fetched. An
# unrecognized value falls back to "generic".
FLIGHT_MANUAL_HTML_SOURCE=generic

# Step 185D: independent, optional per-source local file paths --
# multi-source flight ingestion. Each defaults to its own real path
# under .data/manual_scrapes/ (never created automatically), so every
# source is "known and eligible" out of the box without fabricating
# anything: with no file actually present, that source is honestly
# recorded as missing (see FlightSearchResult.warnings) rather than
# blocking any other source that *does* have a file. These are
# independent of, and additive to, SCRAPED_FLIGHT_HTML_PATH/
# FLIGHT_MANUAL_HTML_SOURCE above -- supplying only the original single
# file (the pre-185D default) still works exactly as before. Set any of
# these to an empty value to disable that one source's slot entirely.
# "kiwi_manual" here is the same manual/local-file-only concept as
# FLIGHT_MANUAL_HTML_SOURCE=kiwi above -- named "kiwi_manual" (never bare
# "kiwi") specifically so it stays visually distinct, in config, in code,
# and in every log/message, from the separate, real, live
# FLIGHT_PROVIDER=kiwi_mcp integration below. Each source-specific parser
# (backend/app/providers/flights/source_parsers/) recognizes the same
# generic HTML micro-format as every other source, optionally annotated
# per-card with a synthetic data-source="<brand>" attribute -- still
# never a live fetch, still never browser automation, still never a
# claim that any of these paths hold real Skyscanner/Google Flights/Kiwi
# data.
SCRAPED_FLIGHT_HTML_PATH_SKYSCANNER=.data/manual_scrapes/flights_skyscanner.html
SCRAPED_FLIGHT_HTML_PATH_GOOGLE_FLIGHTS=.data/manual_scrapes/flights_google_flights.html
SCRAPED_FLIGHT_HTML_PATH_KIWI_MANUAL=.data/manual_scrapes/flights_kiwi_manual.html

# --- Kiwi MCP flight provider (optional; real, live, third-party) ---
# Off by default. Requires BOTH FLIGHT_PROVIDER=kiwi_mcp above AND
# KIWI_MCP_ENABLED=true here -- either alone does nothing live. When
# enabled, this makes a real network call to Kiwi's hosted MCP server.
# Any booking link returned is a provider-supplied third-party link, not
# a booking confirmation.
KIWI_MCP_ENABLED=false
KIWI_MCP_ENDPOINT=https://mcp.kiwi.com
KIWI_MCP_TIMEOUT_SECONDS=10.0
# KIWI_MCP_TOOL_NAME=

# --- AI candidate proposal (optional; reasoning/proposal only) ---
# "not_connected" (default), "anthropic", or "groq". Neither is ever a
# source of factual travel data -- a suggestion only reaches the
# itinerary after independent provider-grounding and explicit promotion.
#
# Two separate, non-interchangeable switches gate when this actually runs:
#   AI_CANDIDATE_DISCOVERY_ENABLED (Step 191A) is the real production
#     switch -- when true, the default LangGraph engine's `ai_candidate`
#     stage runs live discovery/grounding/promotion during normal
#     POST /trips/{id}/generate, and a promoted candidate can be scheduled
#     into the itinerary.
#   AI_CANDIDATE_DISCOVERY_SHADOW_MODE_ENABLED (Step 161B) is a separate,
#     legacy-engine-only (PLANNING_ENGINE_MODE=legacy) observation/testing
#     path -- it only populates ai_candidate_proposal_batch/
#     candidate_grounding_batch for inspection and is never read by the
#     LangGraph engine regardless of its value. Kept for backward
#     compatibility; do not treat it as the production flag.
# Both default to false; setting one does not enable the other.
AI_CANDIDATE_PROPOSAL_PROVIDER=not_connected
AI_CANDIDATE_DISCOVERY_ENABLED=false
AI_CANDIDATE_DISCOVERY_SHADOW_MODE_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- Section 193A/193B: itinerary-reasoning (LLM #2) contract + provider ---
# A separate feature from AI candidate proposal above -- LLM #2 only
# selects/groups/orders already-verified, provider-backed candidate IDs
# (Sections 191-192A); it never proposes a new place itself. Wired into
# the live LangGraph generation path as of Section 193C (the
# ai_itinerary_reasoning node, gated by AI_ITINERARY_REASONING_ENABLED
# below).
#
# AI_ITINERARY_REASONING_MAX_CANDIDATES caps how many
# ItineraryCandidateReference entries AIItineraryReasoningRequestBuilder
# includes in one request, selected deterministically by quality tier
# then score -- never by AI proposal confidence.
#
# AI_ITINERARY_REASONING_ENABLED/AI_ITINERARY_REASONING_PROVIDER mirror
# AI_CANDIDATE_DISCOVERY_ENABLED/AI_CANDIDATE_PROPOSAL_PROVIDER above --
# "not_connected" (default), "anthropic", or "groq". No separate API key
# setting: both adapters reuse ANTHROPIC_API_KEY/GROQ_API_KEY above.
# AI_ITINERARY_REASONING_MODEL is optional and falls back to
# ANTHROPIC_MODEL/GROQ_MODEL above when unset.
AI_ITINERARY_REASONING_MAX_CANDIDATES=40
AI_ITINERARY_REASONING_ENABLED=false
AI_ITINERARY_REASONING_PROVIDER=not_connected
# AI_ITINERARY_REASONING_MODEL=

# Section 194A/194B: bounded automatic repair of a completed LLM #2
# reasoning result, in response to deterministic routing/validation
# findings (geographic spread, route-needs-review, insufficient travel
# buffer -- never a provider/factual issue). Reuses
# AI_ITINERARY_REASONING_PROVIDER/AI_ITINERARY_REASONING_MODEL above --
# no separate repair provider/model setting, since repair is the same
# LLM #2 job, just scoped to a subset of days. AI_ITINERARY_REPAIR_ENABLED
# defaults false, so a normal generation stays exactly Section 193C's
# behavior until explicitly opted in.
# AI_ITINERARY_REPAIR_MAX_ATTEMPTS is a hard-capped bound (1 or 2 only) --
# the loop always terminates and never retries indefinitely.
AI_ITINERARY_REPAIR_ENABLED=false
AI_ITINERARY_REPAIR_MAX_ATTEMPTS=1

# Section 196: AI feedback interpreter -- translates a user's natural-
# language itinerary feedback into a structured change request (which
# existing item to remove/move, a pace/preference change, an unresolved
# new-place request, explicit "do not change" preservation). A
# genuinely separate job from itinerary reasoning/repair above, so it
# gets its own provider/model settings rather than reusing
# AI_ITINERARY_REASONING_PROVIDER/AI_ITINERARY_REASONING_MODEL -- no
# separate API key setting: both adapters reuse ANTHROPIC_API_KEY/
# GROQ_API_KEY above. AI_FEEDBACK_INTERPRETER_MODEL is optional and
# falls back to ANTHROPIC_MODEL/GROQ_MODEL above when unset. Called by
# the targeted regeneration runtime path (see TARGETED_REGENERATION_ENABLED
# below) when that flag is also on; otherwise still only reachable via a
# direct, isolated call to AIFeedbackInterpreterService.
AI_FEEDBACK_INTERPRETER_ENABLED=false
AI_FEEDBACK_INTERPRETER_PROVIDER=not_connected
# AI_FEEDBACK_INTERPRETER_MODEL=

# Section 197C: the runtime gate for POST /trips/{trip_id}/regenerate to
# use the targeted (Sections 196/197A/197B) pipeline instead of the
# legacy coarse whole-stage-rerun path. Separate from
# AI_FEEDBACK_INTERPRETER_ENABLED above -- that flag controls whether the
# interpreter may call a provider at all; this one controls whether
# /regenerate routes through it. Default false: a fresh deployment's
# /regenerate behavior is unchanged until both this and
# AI_FEEDBACK_INTERPRETER_ENABLED (plus a real provider) are explicitly
# turned on. When true but the interpreter is unavailable, /regenerate
# returns an honest targeted-mode failure -- it never silently falls back
# to broad legacy regeneration.
TARGETED_REGENERATION_ENABLED=false

# --- Itinerary narrator (optional; Step 182F; read-only presentation prose) ---
# A completely separate feature from AI candidate proposal above -- do
# NOT reuse AI_CANDIDATE_PROPOSAL_PROVIDER/
# AI_CANDIDATE_DISCOVERY_SHADOW_MODE_ENABLED for this. Off by default
# (ITINERARY_NARRATOR_ENABLED=false); even when enabled,
# ITINERARY_NARRATOR_PROVIDER still defaults to "not_connected". Reads
# an already-finished PlanningState only (destination, dates, scheduled
# place names/reasons, weather range, offer counts, validation status) --
# it can never create a hotel, flight, price, rating, route, or booking,
# and it never changes provider coverage, validation readiness, route
# feasibility, or any other factual field. Generation/regeneration always
# succeed whether this is disabled or its provider call fails.
#
# To use Groq: create a key in the GroqCloud Console, put it in
# GROQ_API_KEY above, then set:
#   ITINERARY_NARRATOR_PROVIDER=groq
#   ITINERARY_NARRATOR_ENABLED=true
#
# To use Anthropic: create a key in the Claude/Anthropic Console under
# Settings > API keys, put it in ANTHROPIC_API_KEY above, then set:
#   ITINERARY_NARRATOR_PROVIDER=anthropic
#   ITINERARY_NARRATOR_ENABLED=true
ITINERARY_NARRATOR_ENABLED=false
ITINERARY_NARRATOR_PROVIDER=not_connected
# ITINERARY_NARRATOR_MODEL=
ITINERARY_NARRATOR_TIMEOUT_SECONDS=20.0
ITINERARY_NARRATOR_MAX_DAYS=10
ITINERARY_NARRATOR_MAX_ITEMS_PER_DAY=6

# OPENAI_API_KEY/OPENAI_MODEL are declared in config.py but are not
# referenced anywhere else in the codebase today -- Anthropic/Groq are
# the actual wired AI-candidate-proposal bases. Left here only because
# the field still exists in config.py; setting it has no effect.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Other declared-but-not-yet-connected provider keys (optional) ---
# None of these are wired into any provider adapter yet -- setting them
# has no effect on current app behavior.
GOOGLE_PLACES_API_KEY=
GOOGLE_ROUTES_API_KEY=
MAPBOX_ACCESS_TOKEN=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# --- Partner/paid-access lodging & flight provider placeholders (Step 182E) ---
# None of these are wired into any provider adapter or factory yet --
# setting any of them has zero effect on accommodation_provider/
# flight_provider/hotel_ratings_provider selection today. They exist only
# as a typed, documented place to put a real credential *if and when* a
# real adapter for that provider is implemented (with its own request/
# response schema and tests). Every field below is empty by default; this
# file never contains a real key. See README.md's "Provider activation"
# section for what each one is for, how to get access at a high level,
# and this app's manual/local HTML fallback for when access is
# paid/partner-blocked (the common case for all of these today).
BOOKING_DEMAND_API_KEY=
BOOKING_DEMAND_API_BASE_URL=
EXPEDIA_RAPID_API_KEY=
EXPEDIA_RAPID_API_SECRET=
EXPEDIA_RAPID_API_BASE_URL=
HOTELBEDS_API_KEY=
HOTELBEDS_SECRET=
HOTELBEDS_API_BASE_URL=
HOSTELWORLD_API_KEY=
HOSTELWORLD_API_BASE_URL=
VRBO_PARTNER_API_KEY=
VRBO_PARTNER_API_BASE_URL=
AIRBNB_PARTNER_API_KEY=
AIRBNB_PARTNER_API_BASE_URL=
SKYSCANNER_API_KEY=
SKYSCANNER_API_BASE_URL=
TRIPADVISOR_API_KEY=
TRIPADVISOR_API_BASE_URL=

# --- Planning engine selection ---
# "langgraph" (default) or "legacy". Both call the exact same
# deterministic stage services in the same order -- this only changes how
# the stages are invoked, never what any stage may decide or invent.
PLANNING_ENGINE_MODE=langgraph

# --- Auth/session foundation (Step 184B) ---
# Foundation only: no /auth/* routes exist yet (Step 184C), no /trips/*
# route requires a session yet (Step 184D), and no trip has an owner yet.
# Nothing below has any effect on current app behavior.
#
# SESSION_SECRET_KEY must stay blank here and be set only in your own
# real, never-committed `.env` -- session signing/verification is
# refused outright while this is unset (see
# backend/app/auth/sessions.py), never silently falls back to a
# default/shared key. Generate a real value for local use with e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(32))"` --
# never reuse the same value across environments, and never commit it.
SESSION_SECRET_KEY=
SESSION_COOKIE_NAME=travelobligator_session
# One week. No refresh flow exists in this MVP -- re-login after expiry
# is the expected behavior once login exists.
SESSION_TTL_SECONDS=604800
# `false` for local HTTP development (http://localhost:3000). A real
# HTTPS deployment must set this to `true` -- Secure cookies require
# HTTPS, and this app never overrides that on its own behalf.
SESSION_COOKIE_SECURE=false
# "lax" (default), "strict", or "none" -- an unrecognized value falls
# back to "lax" rather than raising.
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_HTTPONLY=true

# --- Observability / structured logging (Step 187B) ---
# Stdlib-only structured logging foundation, following Step 187A's
# read-only audit -- no OpenTelemetry, Elastic APM, Sentry, Datadog, or
# structlog dependency exists in this codebase, and neither setting
# below adds one. Nothing here ships a log line anywhere outside this
# process's own stdout -- no external log-shipping/APM destination is
# configurable. Only the fields already listed in
# backend/app/core/logging_config.py's ALLOWED_EXTRA_FIELDS are ever
# rendered on a log line (e.g. trip_id/job_id/status); passwords,
# session cookies, tokens, API keys, request/response bodies, provider
# payloads, full PlanningState, and full itinerary content are never
# logged, by construction of that allowlist. Request-scoped
# `request_id` correlation does not exist yet -- that is Step 187C's
# job. No existing request/response/provider/auth/persistence/async-job
# behavior changes because of either setting below.
#
# "DEBUG"/"INFO" (default)/"WARNING"/"ERROR"/"CRITICAL" -- an
# unrecognized value normalizes to "INFO" rather than raising.
LOG_LEVEL=INFO
# `true` (default) renders every existing logger.* call as one JSON
# object per stdout line; `false` falls back to a plain, single-line,
# human-readable formatter instead. Either way, only the same
# already-existing logger.warning(...) call sites log anything -- this
# step adds no new logging call site.
STRUCTURED_LOGGING_ENABLED=true
