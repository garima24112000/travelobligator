# TravelObligator -- environment template (Step 181D)
#
# Copy this file to `.env` (`cp .env.example .env`) and edit only what you
# need. Every value below is either the same default `backend/app/core/
# config.py` already uses, or an empty placeholder for an optional secret.
# Nothing here needs to change to run the app locally with its honest
# default behavior: most providers default to `not_connected`, and the
# two `scraped_local` providers (accommodation/flights) read a local file
# that does not exist yet, so they honestly report `unavailable`.
#
# Never commit a real `.env` file with real secrets. This template file
# itself contains no real API keys.

# --- App basics ---
APP_NAME=TravelObligator
APP_ENV=development
APP_DEBUG=true
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Persistence (interim, pre-database -- see ARCHITECTURE.md section 12a) ---
# Trips/planning states are actually persisted to this local, gitignored
# JSON file today, not to a database.
LOCAL_STORAGE_PATH=.data/travelobligator_state.json

# PERSISTENCE_BACKEND (Step 183B) gates which persistence backend the app
# uses. "local_json" (the default -- always the safe choice, keep this
# unless you deliberately want Postgres) reads/writes LocalJsonStore, the
# same behavior this app has always had. "postgres" (Step 183D+) switches
# every repository (trips, planning states) to a real Postgres-backed
# implementation instead -- but ONLY when you explicitly set this to
# "postgres"; nothing else on this page does that for you.
#
# IMPORTANT: setting DATABASE_URL below does NOT by itself switch
# persistence to Postgres -- you must also explicitly set
# PERSISTENCE_BACKEND=postgres.
PERSISTENCE_BACKEND=local_json

# DATABASE_URL / REDIS_URL are declared in config.py and read by
# docker-compose.yml's postgres/redis containers. DATABASE_URL is only
# actually read by the app when PERSISTENCE_BACKEND=postgres (see above);
# REDIS_URL is never read by any code path in backend/app/ today.
#
# The hostname/port you use here depends on WHERE the process connecting
# is running, not on where Postgres itself runs:
#   - Backend running INSIDE `docker compose` (the `backend` service):
#     use the service name and the container's own internal port --
#     `postgres:5432` (the default below). Compose's internal network
#     resolves `postgres` regardless of what POSTGRES_HOST_PORT maps to
#     on your host.
#   - Alembic or the backend running on your HOST machine (not inside
#     compose) against a `docker compose up -d postgres` container: use
#     `localhost:<POSTGRES_HOST_PORT>` (see POSTGRES_HOST_PORT below --
#     `localhost:5432` if you left it at its default, `localhost:15432`
#     if you changed it because 5432 was already taken).
DATABASE_URL=postgresql://travelobligator_user:change_me@postgres:5432/travelobligator
REDIS_URL=redis://redis:6379/0

# Read by docker-compose.yml's postgres container only (not by the app
# itself) -- must match the credentials embedded in DATABASE_URL above if
# you change either. Only needed if you opt into `docker compose up
# postgres` for the Step 183C schema migration; not required for normal
# local_json development.
POSTGRES_DB=travelobligator
POSTGRES_USER=travelobligator_user
POSTGRES_PASSWORD=change_me

# POSTGRES_HOST_PORT (Step 183E) -- which port on YOUR machine
# docker-compose.yml's postgres container's 5432 is published to.
# Defaults to 5432 if unset (backwards compatible). A local Postgres
# install, or another project's compose stack, commonly already occupies
# 5432 -- if `docker compose up -d postgres` fails with "address already
# in use", set this to a nonstandard port instead (15432 is a common
# choice) rather than stopping whatever else is using 5432. This only
# changes the HOST side of the mapping -- containers within compose
# (e.g. `backend`) always reach Postgres at `postgres:5432` regardless of
# this value; only host-side connections (Alembic/pytest run directly on
# your machine, not inside a container) need to use this port, via
# `localhost:<this value>` in DATABASE_URL above.
# POSTGRES_HOST_PORT=15432

# Step 183C added the first Alembic schema migration (`trips` +
# `planning_states`, see docs/14_backend_architecture.md section 104).
# Step 183D added a real, working Postgres repository implementation
# behind it (see docs/14_backend_architecture.md section 105) -- but it
# all remains entirely opt-in, gated on PERSISTENCE_BACKEND=postgres
# above; the app still uses local_json by default. To try it against a
# real local Postgres: `docker compose up -d postgres` (add
# `POSTGRES_HOST_PORT=15432` before that command first if 5432 is
# already taken), then from `backend/`: `DATABASE_URL=postgresql://
# travelobligator_user:change_me@localhost:<port>/travelobligator
# alembic upgrade head`. This is never required for `pytest` or normal
# `local_json` development -- see docs/14_backend_architecture.md
# section 106 for the full opt-in verification walkthrough.

# --- Provider cache (local SQLite cache for real provider responses) ---
PROVIDER_CACHE_ENABLED=true
PROVIDER_CACHE_PATH=.data/provider_cache.sqlite3
OPEN_METEO_CACHE_TTL_SECONDS=3600
NAGER_DATE_CACHE_TTL_SECONDS=2592000
FRANKFURTER_CACHE_TTL_SECONDS=21600
OSM_GEOCODE_CACHE_TTL_SECONDS=2592000
OSM_POI_CACHE_TTL_SECONDS=604800

# --- Real, connected-by-default provider endpoints ---
# These are already live/connected with no extra configuration -- you
# generally never need to change them.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
NOMINATIM_API_URL=https://nominatim.openstreetmap.org
OPEN_METEO_API_URL=https://api.open-meteo.com
NAGER_DATE_API_URL=https://date.nager.at
FRANKFURTER_API_URL=https://api.frankfurter.app

# --- Safety flags ---
# ALLOW_MOCK_TRAVEL_FACTS must stay false -- this app never fabricates
# travel facts as a matter of policy, not just a default.
USE_REAL_PROVIDERS=true
ALLOW_MOCK_TRAVEL_FACTS=false

# --- Routing provider (optional, no-key MVP activation available) ---
# "not_connected" (default) or "osrm". Setting ROUTING_PROVIDER=osrm alone
# still does nothing live unless OSRM_BASE_URL is also set -- no route
# time or path is ever shown when not connected, and this stays the
# default unless you explicitly opt in.
#
# To enable real route feasibility/movement rows/map paths for a local
# demo with NO API key and NO signup, uncomment the OSRM_BASE_URL line
# below to point at the public OSRM demo server:
#
#   ROUTING_PROVIDER=osrm
#   OSRM_BASE_URL=https://router.project-osrm.org
#
# That demo server is free and requires no credentials, but it is a
# shared public instance with no uptime or rate-limit guarantee -- fine
# for local development/demos, not something to point production traffic
# at. If you leave OSRM_BASE_URL unset (the default), routing honestly
# stays `not_connected` even if ROUTING_PROVIDER=osrm is set.
ROUTING_PROVIDER=not_connected
# OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_SECONDS=15.0
OSRM_PROFILE=driving
OSRM_ROUTE_CACHE_TTL_SECONDS=86400

# --- Route-aware scheduling ---
# Already enabled by default. Uses provider-backed movement data when a
# routing provider is actually connected (see ROUTING_PROVIDER/
# OSRM_BASE_URL above); falls back to a documented, deterministic order
# when it isn't. Only ever applies a suggestion with a genuinely positive
# real improvement -- this flag controls whether that check is allowed to
# run at all, not whether routing itself is connected.
ROUTE_AWARE_SCHEDULING_ENABLED=true
ROUTE_AWARE_SCHEDULING_MIN_IMPROVEMENT_SECONDS=0.0

# --- Accommodation inventory ---
# "not_connected", "scraped_local", or "manual_html" (alias for
# scraped_local, Step 182E -- pick whichever name reads more clearly to
# you, both select the exact same adapter). Default is "scraped_local".
# Either name reads a local, developer-supplied static HTML file only --
# it never fetches a live website. With no file at the path below, it
# honestly reports `unavailable`, never fabricated data. See README.md's
# "Provider activation" section for the full per-provider access/fallback
# matrix (Booking.com, Expedia, Hotelbeds, Hostelworld, Vrbo, Airbnb all
# require real partner/API access this app does not implement -- their
# fallback path is this same manual/local HTML file).
ACCOMMODATION_PROVIDER=scraped_local
SCRAPING_ENABLED=true
SCRAPED_ACCOMMODATION_PROVIDER_ENABLED=true
SCRAPED_ACCOMMODATION_HTML_PATH=.data/manual_scrapes/accommodations.html
SCRAPED_ACCOMMODATION_SOURCE_ID=manual_local_scraped_accommodation
SCRAPED_ACCOMMODATION_SOURCE_NAME=Manual local scraped accommodation source
# SCRAPED_ACCOMMODATION_BASE_URL=
SCRAPED_ACCOMMODATION_CACHE_ENABLED=true
SCRAPED_ACCOMMODATION_CACHE_TTL_SECONDS=3600
SCRAPING_DEFAULT_RATE_LIMIT_SECONDS=10

# Optional (Step 182E): cosmetic provenance label for the manual/local
# accommodation file above -- "generic" (default), "booking", "expedia",
# "hotelbeds", "hostelworld", "vrbo", or "airbnb". Only changes the
# displayed source_id/source_name (e.g. "Manual/local HTML (labeled by
# user as Booking.com-derived; not official Booking.com data)") on
# parsed offers -- and only when SCRAPED_ACCOMMODATION_SOURCE_ID/_NAME
# above are left at their defaults. Never means the real Booking/Expedia/
# Hotelbeds/Hostelworld/Vrbo/Airbnb API was called; an unrecognized value
# falls back to "generic".
ACCOMMODATION_MANUAL_HTML_SOURCE=generic

# --- Hotel ratings (optional; no live rating provider exists yet) ---
# "not_connected" is the only supported value today. This layer can
# enrich a lodging offer with a provider-backed rating snapshot once a
# real ratings provider is wired in -- never a quality guarantee. See
# README.md's "Provider activation" section for Tripadvisor Content API
# access steps -- TRIPADVISOR_API_KEY below is a placeholder only; no
# Tripadvisor adapter exists, and no Tripadvisor scraping is implemented
# or planned.
HOTEL_RATINGS_PROVIDER=not_connected

# --- Flight inventory ---
# "not_connected", "scraped_local", "manual_html" (alias for
# scraped_local, Step 182E), or "kiwi_mcp" (see below). Default is
# "scraped_local". scraped_local/manual_html mirror the accommodation
# parser: local file only, never live scraping, honestly `unavailable`
# with no file present. See README.md's "Provider activation" section for
# Skyscanner's access requirements -- its fallback path is this same
# manual/local HTML file.
FLIGHT_PROVIDER=scraped_local
SCRAPED_FLIGHT_PROVIDER_ENABLED=true
SCRAPED_FLIGHT_HTML_PATH=.data/manual_scrapes/flights.html
SCRAPED_FLIGHT_SOURCE_ID=manual_local_scraped_flight
SCRAPED_FLIGHT_SOURCE_NAME=Manual local scraped flight source
# SCRAPED_FLIGHT_BASE_URL=
SCRAPED_FLIGHT_CACHE_ENABLED=true
SCRAPED_FLIGHT_CACHE_TTL_SECONDS=3600

# Optional (Step 182E): cosmetic provenance label for the manual/local
# flight file above -- "generic" (default), "skyscanner", "google_flights",
# "kiwi", or "other". Only changes the displayed source_id/source_name on
# parsed offers, and only when SCRAPED_FLIGHT_SOURCE_ID/_NAME above are
# left at their defaults. The "kiwi" value here means "this manually-saved
# local file is labeled by the user as Kiwi-derived" -- it is a completely
# separate, cosmetic-only setting from FLIGHT_PROVIDER=kiwi_mcp/
# KIWI_MCP_ENABLED below and never means live Kiwi MCP data. An
# unrecognized value falls back to "generic".
FLIGHT_MANUAL_HTML_SOURCE=generic

# --- Kiwi MCP flight provider (optional; real, live, third-party) ---
# Off by default. Requires BOTH FLIGHT_PROVIDER=kiwi_mcp above AND
# KIWI_MCP_ENABLED=true here -- either alone does nothing live. When
# enabled, this makes a real network call to Kiwi's hosted MCP server.
# Any booking link returned is a provider-supplied third-party link, not
# a booking confirmation.
KIWI_MCP_ENABLED=false
KIWI_MCP_ENDPOINT=https://mcp.kiwi.com
KIWI_MCP_TIMEOUT_SECONDS=10.0
# KIWI_MCP_TOOL_NAME=

# --- AI candidate proposal (optional; reasoning/proposal only) ---
# "not_connected" (default), "anthropic", or "groq". Neither is ever a
# source of factual travel data -- a suggestion only reaches the
# itinerary after independent provider-grounding and explicit promotion.
# AI_CANDIDATE_DISCOVERY_SHADOW_MODE_ENABLED must also be true for either
# to actually run during plan generation.
AI_CANDIDATE_PROPOSAL_PROVIDER=not_connected
AI_CANDIDATE_DISCOVERY_SHADOW_MODE_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- Itinerary narrator (optional; Step 182F; read-only presentation prose) ---
# A completely separate feature from AI candidate proposal above -- do
# NOT reuse AI_CANDIDATE_PROPOSAL_PROVIDER/
# AI_CANDIDATE_DISCOVERY_SHADOW_MODE_ENABLED for this. Off by default
# (ITINERARY_NARRATOR_ENABLED=false); even when enabled,
# ITINERARY_NARRATOR_PROVIDER still defaults to "not_connected". Reads
# an already-finished PlanningState only (destination, dates, scheduled
# place names/reasons, weather range, offer counts, validation status) --
# it can never create a hotel, flight, price, rating, route, or booking,
# and it never changes provider coverage, validation readiness, route
# feasibility, or any other factual field. Generation/regeneration always
# succeed whether this is disabled or its provider call fails.
#
# To use Groq: create a key in the GroqCloud Console, put it in
# GROQ_API_KEY above, then set:
#   ITINERARY_NARRATOR_PROVIDER=groq
#   ITINERARY_NARRATOR_ENABLED=true
#
# To use Anthropic: create a key in the Claude/Anthropic Console under
# Settings > API keys, put it in ANTHROPIC_API_KEY above, then set:
#   ITINERARY_NARRATOR_PROVIDER=anthropic
#   ITINERARY_NARRATOR_ENABLED=true
ITINERARY_NARRATOR_ENABLED=false
ITINERARY_NARRATOR_PROVIDER=not_connected
# ITINERARY_NARRATOR_MODEL=
ITINERARY_NARRATOR_TIMEOUT_SECONDS=20.0
ITINERARY_NARRATOR_MAX_DAYS=10
ITINERARY_NARRATOR_MAX_ITEMS_PER_DAY=6

# OPENAI_API_KEY/OPENAI_MODEL are declared in config.py but are not
# referenced anywhere else in the codebase today -- Anthropic/Groq are
# the actual wired AI-candidate-proposal bases. Left here only because
# the field still exists in config.py; setting it has no effect.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Other declared-but-not-yet-connected provider keys (optional) ---
# None of these are wired into any provider adapter yet -- setting them
# has no effect on current app behavior.
GOOGLE_PLACES_API_KEY=
GOOGLE_ROUTES_API_KEY=
MAPBOX_ACCESS_TOKEN=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# --- Partner/paid-access lodging & flight provider placeholders (Step 182E) ---
# None of these are wired into any provider adapter or factory yet --
# setting any of them has zero effect on accommodation_provider/
# flight_provider/hotel_ratings_provider selection today. They exist only
# as a typed, documented place to put a real credential *if and when* a
# real adapter for that provider is implemented (with its own request/
# response schema and tests). Every field below is empty by default; this
# file never contains a real key. See README.md's "Provider activation"
# section for what each one is for, how to get access at a high level,
# and this app's manual/local HTML fallback for when access is
# paid/partner-blocked (the common case for all of these today).
BOOKING_DEMAND_API_KEY=
BOOKING_DEMAND_API_BASE_URL=
EXPEDIA_RAPID_API_KEY=
EXPEDIA_RAPID_API_SECRET=
EXPEDIA_RAPID_API_BASE_URL=
HOTELBEDS_API_KEY=
HOTELBEDS_SECRET=
HOTELBEDS_API_BASE_URL=
HOSTELWORLD_API_KEY=
HOSTELWORLD_API_BASE_URL=
VRBO_PARTNER_API_KEY=
VRBO_PARTNER_API_BASE_URL=
AIRBNB_PARTNER_API_KEY=
AIRBNB_PARTNER_API_BASE_URL=
SKYSCANNER_API_KEY=
SKYSCANNER_API_BASE_URL=
TRIPADVISOR_API_KEY=
TRIPADVISOR_API_BASE_URL=

# --- Planning engine selection ---
# "langgraph" (default) or "legacy". Both call the exact same
# deterministic stage services in the same order -- this only changes how
# the stages are invoked, never what any stage may decide or invent.
PLANNING_ENGINE_MODE=langgraph
